# --- Database ---
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=datapulse
POSTGRES_DB=datapulse
DATABASE_URL=postgresql://datapulse:datapulse@localhost:5432/datapulse

# --- API ---
# Comma-separated CORS origins. Development default: http://localhost:5173.
# In production, set the Vercel origin, for example https://datapulse.vercel.app.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Run `alembic upgrade head` when the API container starts.
# 1 applies migrations at boot; 0 skips them.
RUN_MIGRATIONS=1

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Production — never commit real values ---
# Neon:          create PostgreSQL, enable PostGIS, and copy the direct connection
#                string with sslmode=require&channel_binding=require.
# Render API:    DATABASE_URL = Neon connection string;
#                CORS_ALLOW_ORIGINS = Vercel origin.
# GitHub Actions: DATABASE_URL secret = the same Neon connection string.
# Vercel web:    VITE_API_URL = public Render backend URL.
