# --- Database ---
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=datapulse
POSTGRES_DB=datapulse
DATABASE_URL=postgresql://datapulse:datapulse@localhost:5432/datapulse

# --- API ---
# Origin consentiti dal CORS (separati da virgola). Default dev: http://localhost:5173 (Vite).
# In produzione valorizzare con l'origin Vercel, es.: https://datapulse.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:5173

# Esegui 'alembic upgrade head' all'avvio del container API (docker-entrypoint.sh).
# 1 = applica le migrazioni al boot (default, usato su Render free); 0 = salta.
RUN_MIGRATIONS=1

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Produzione — NON committare valori reali, solo dove impostarli ---
# Neon (DB):      creare PostgreSQL, abilitare PostGIS e copiare la connection string
#                 diretta con sslmode=require&channel_binding=require.
# Render (API):   DATABASE_URL = connection string Neon;
#                 CORS_ALLOW_ORIGINS = origin Vercel (Render Dashboard → Environment).
# GitHub Actions: secret DATABASE_URL = la stessa connection string Neon usata dall'API.
# Vercel (web):  VITE_API_URL = URL pubblico del backend Render, es. https://datapulse-api.onrender.com
